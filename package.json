{
  "name": "switchyard",
  "version": "0.2.0",
  "description": "Local dashboard for AI coding agents, plus a Mac app that sorts your windows by project",
  "bin": {
    "switchyard": "./dist/index.js"
  },
  "files": [
    "dist/",
    "src/hook/",
    "src/dashboard/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/dashboard && cp -r src/dashboard dist/dashboard",
    "dev": "node src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "Apache-2.0",
  "author": "Cyrus David Pastelero",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyruspastelero/switchyard"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "agent",
    "dashboard",
    "window-management",
    "mcp",
    "monitoring"
  ],
  "type": "module"
}
